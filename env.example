# ============================================================
# LIGHTHOUSE CHURCH - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
# For Supabase: get this from Project Settings > Database > Connection String
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT Secret - generate a long random string (e.g. run: openssl rand -base64 64)
JWT_SECRET=replace_this_with_a_long_random_secret_string_minimum_32_characters

# Frontend URL (for CORS - set to your deployed frontend domain in production)
FRONTEND_URL=http://localhost:3000

# Optional: Email (Phase 2 - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=Lighthouse Church <noreply@lighthousechurch.org>
